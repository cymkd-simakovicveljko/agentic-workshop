    { "id": "revise", "from": "review", "to": "context", "label": "revised direction", "classification": "new instruction", "variant": "dashed", "route": "top-channel" }
  ],
  "cards": [
    { "dot": "cyan", "title": "Context is assembled", "items": ["The model sees supplied context, not the whole disk", "Only selected files become prompt-visible"] },
    { "dot": "rose", "title": "Data is not authority", "items": ["Retrieved text can be untrusted material", "Human instructions define the task and can revise it"] }
