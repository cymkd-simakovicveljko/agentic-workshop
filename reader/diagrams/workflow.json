{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "From Intent to Accepted Change",
    "output": "workflow.html",
    "animation": "none",
    "quality_profile": "showcase",
    "legend": { "mode": "hidden" },
    "viewBox": [1180, 720]
  },
  "lanes": [
    { "id": "human", "label": "Human" },
    { "id": "agent", "label": "Agent" }
  ],
  "phases": [
    { "id": "frame", "label": "Frame the work", "fromCol": 0, "toCol": 1, "variant": "emphasis" },
    { "id": "work", "label": "Plan + execute", "fromCol": 2, "toCol": 3 },
    { "id": "check", "label": "Verify + decide", "fromCol": 4, "toCol": 5, "variant": "dashed" }
  ],
  "mainPath": ["understand", "specify", "plan", "execute", "verify", "accept"],
  "semanticChecks": {
    "allowedRoots": ["understand"],
    "allowedTerminals": ["accept"],
    "requiredEdges": [
      { "from": "verify", "to": "revise" },
      { "from": "verify", "to": "accept" },
      { "from": "revise", "to": "plan" }
    ]
  },
  "nodes": [
    { "id": "understand", "lane": "human", "col": 0, "type": "external", "label": "Understand", "sublabel": "goal + constraints", "width": 148 },
    { "id": "specify", "lane": "agent", "col": 1, "type": "backend", "label": "Specify", "sublabel": "definition of done", "width": 148 },
    { "id": "plan", "lane": "agent", "col": 2, "type": "backend", "label": "Plan", "sublabel": "small next step", "width": 148 },
    { "id": "execute", "lane": "agent", "col": 3, "type": "messagebus", "label": "Execute", "sublabel": "permitted change", "width": 148 },
    { "id": "verify", "lane": "human", "col": 4, "type": "external", "label": "Verify", "sublabel": "inspect outcome", "width": 148 },
    { "id": "revise", "lane": "human", "col": 5, "type": "external", "label": "Revise", "sublabel": "tighten the plan", "width": 148, "yOffset": -64 },
    { "id": "accept", "lane": "human", "col": 5, "type": "external", "label": "Accept", "sublabel": "meets the bar", "width": 148, "yOffset": 64 }
  ],
  "edges": [
    { "id": "intent-to-spec", "from": "understand", "to": "specify", "label": "constraints", "variant": "emphasis", "role": "main" },
    { "id": "spec-to-plan", "from": "specify", "to": "plan", "label": "contract", "role": "main" },
    { "id": "plan-to-execute", "from": "plan", "to": "execute", "label": "next step", "role": "main" },
    { "id": "execute-to-verify", "from": "execute", "to": "verify", "label": "evidence", "variant": "emphasis", "role": "main" },
    { "id": "verify-to-accept", "from": "verify", "to": "accept", "label": "meets bar", "variant": "emphasis", "role": "main" },
    { "id": "verify-to-revise", "from": "verify", "to": "revise", "label": "not yet", "variant": "dashed", "role": "branch", "route": "outside-right" },
    { "id": "revise-to-plan", "from": "revise", "to": "plan", "label": "reframe", "variant": "dashed", "role": "return", "route": "return-left" }
  ],
  "cards": [
    { "dot": "emerald", "title": "Keep the loop real", "items": ["Verification is a decision, not a checkbox", "A failed check returns to the plan"] },
    { "dot": "cyan", "title": "Accept only evidence", "items": ["The work is accepted when it meets the stated bar"] }
  ]
}
