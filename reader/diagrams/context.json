  "nodes": [
    { "id": "request", "type": "external", "label": "Human input", "sublabel": "goal + instructions", "stage": 0, "row": 0, "tag": "authority" },
    { "id": "filesystem", "type": "database", "label": "Filesystem", "sublabel": "not all read", "stage": 0, "row": 2, "tag": "untouched" },
    { "id": "context", "type": "backend", "label": "Context assembly", "sublabel": "selected material", "stage": 1, "row": 0, "tag": "prompt-visible" },
    { "id": "untrusted", "type": "external", "label": "Retrieved material", "sublabel": "web / body content", "stage": 1, "row": 2, "tag": "untrusted" },
    { "id": "model", "type": "cloud", "label": "Model call", "sublabel": "uses supplied context", "stage": 2, "row": 1 },
    { "id": "tools", "type": "messagebus", "label": "Permitted tools", "sublabel": "requested work", "stage": 3, "row": 1 },
    { "id": "answer", "type": "backend", "label": "Draft + evidence", "sublabel": "candidate result", "stage": 4, "row": 1 },
    { "id": "review", "type": "external", "label": "Human review", "sublabel": "verify / revise", "stage": 4, "row": 0 }
  ],
  "flows": [
    { "id": "instructions", "from": "request", "to": "context", "label": "instructions", "classification": "authoritative input", "variant": "emphasis", "route": "straight", "labelDx": -90, "labelDy": 53 },
    { "id": "selected-files", "from": "filesystem", "to": "context", "label": "selected files", "classification": "only what is read", "variant": "default" },
    { "id": "untrusted-body", "from": "untrusted", "to": "context", "label": "retrieved body", "classification": "untrusted data", "variant": "dashed", "labelDy": 82 },
    { "id": "prompt-context", "from": "context", "to": "model", "label": "prompt context", "classification": "assembled input", "variant": "emphasis" },
    { "id": "tool-request", "from": "model", "to": "tools", "label": "tool request", "classification": "permitted action", "variant": "default", "route": "straight" },
